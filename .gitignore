# Development Tools.
.mypy_cache/
.ruff_cache/
__pycache__/
.idea/
.vscode/

# Environments.
.venv*/
venv*/
conda_env*/

# Python Bytecode.
*.py[cod]

# Distribution/Packaging.
/build/
/dist/
*.egg-info/
.pypirc

# Operating System Junk.
*.DS_Store
Thumbs.db
desktop.ini

# IndexTTS.
/cache/
/checkpoints/*
!/checkpoints/*.yaml
# 术语规则库是每个用户自己的数据（含场景与启用状态），不进仓库。
# 放在 !*.yaml 之后才能生效：缺这个文件时 glossary_store 会从
# glossary.yaml 自动迁移出一个空库，所以别人 clone 后照样能跑。
/checkpoints/glossary_rules.yaml
# 术语扁平表同样是个人的：它由 glossary_rules.yaml 派生，每次保存/启动重建都会
# 重写，入库只会让每个人的本地术语互相覆盖。缺文件时按空库启动，第一次保存
# 会自动把 flat / rules / settings 三个文件一起写出来（已实测）。
# 与 rules 同理，必须写在 !*.yaml 之后，否则白名单会把它放回来。
/checkpoints/glossary.yaml
# 术语设置（cascade 级联开关、active_scenario 当前场景）也是本机偏好：
# 面板上切一次场景就会被重写，入库会让每个人的场景选择互相覆盖。
/checkpoints/glossary_settings.yaml
/outputs/
# 服务端运行时产物：参考音频缓存与日志，仅本机使用
/prompts/
/logs/
# 服务端运行时状态（如 ui_state.json 里的参数锁定），每次运行都会变，不入库
/data/
# 模型加速配置（fp16 开关、diffusion_steps、gpt_batch_size 等）由「保存配置」写盘，
# 内容取决于本机显卡；入库会把某台机器的参数带给所有人（显存小的机器可能直接 OOM）。
# 缺这个文件时 _model_cfg_load() 走 FileNotFoundError 分支，用命令行默认值。
/model_config.json
# BigVGAN CUDA 扩展的本地编译产物（torch.utils.cpp_extension 生成）
/indextts/s2mel/modules/bigvgan/alias_free_activation/cuda/build/

# Local tool scratch
.playwright-cli/
.workbuddy/
.workbuddy-ai/
# GUI smoke-test evidence (kept locally, not part of the repo)
/gui-test-screenshots/

# 一次性调试/审查脚本的临时产物（文件名可能带空格，按字面匹配）
/_audit tmp/
/_audit_tmp/
/.review_tmp_names.py
# 混沌测试/审查跑批的落盘目录
/test-run/

# Example audio files (downloaded on demand, not stored in git)
/examples/*.wav
/tests/sample_prompt.wav

.claude
.memsearch

# ---- 上传 GitHub 前追加 ----
# 本地 AI 工具目录
.zcode/

# 无关代码（服务运行不需要，本地保留）
# 注意：启动诊断器 diagnose.py 在**项目根目录**，不在这两个目录里，
# 所以它随仓库正常交付；缺了它，两个 .bat 的中文报错会退化成英文。
# 下面的 tests/ tools/ 整体是本机脚本与回归测试，不进仓库。
/tests/
/cli_tests/
/tools/
/archive/
/gui-test-screenshots/
/docs/
/profile_vram.py

# 官方 README 宣传资源与 macOS 垃圾文件（服务不引用，server.py 的 /assets/ 路由服务的是 web/）
/assets/
# 仅 v1/CLI 批处理示例使用，Web 服务只用 examples/cases.jsonl
/examples/batch/
# 上游仓库的 CI / docker 发布流程，本仓库不适用
/.github/
# 上游 PyPI 打包清单，本仓库不发布
/MANIFEST.in

# IndexTTS v1 专属死代码（v2 推理链路 infer_v2.py 不引用，本地保留可随时恢复）
/indextts/infer.py
/indextts/cli.py
/indextts/gpt/model.py
/indextts/vqvae/

# 本地打包资源：随便携包分发的 ffmpeg 二进制（约 84MB，不进 git）
/tools/ffmpeg/
